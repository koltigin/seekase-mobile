{
  "expo": {
    "scheme": "seekase",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "web": {
      "output": "static"
    },
    "name": "Seekase",
    "slug": "seekase",
    "version": "1.0.0",
    "icon": "./assets/brand/exports/android/icon-1024.png",
    "android": {
      "package": "com.seekase.app",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/exports/android/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/exports/android/adaptive-monochrome.png",
        "backgroundColor": "#161310"
      }
    },
    "plugins": [
      [
        "expo-dev-client",
        {
          "showMenuAtLaunch": false,
          "skipOnboarding": true
        }
      ],
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo for your collection.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "735f0501-7c87-48dd-8814-a24f77a15c8f"
      }
    },
    "owner": "koltigin"
  }
}
