# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android

# local release artifacts (distributed separately from source)
/submission/*.apk
/submission/*.mp4

# temporary local QA dumps (not phase review artifacts)
.mwa-test/
*.log
.expo/dev/
/supabase/.temp/

# OS / editor noise
.idea/
.cursor/
*.swp
*~

