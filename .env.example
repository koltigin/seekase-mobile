# Seekase backend (Supabase) — placeholders only.
# Copy to `.env` and fill with your project values. Never commit real keys.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Keep development builds on Devnet. Set both values for a reviewed production build.
EXPO_PUBLIC_SOLANA_NETWORK=devnet
# EXPO_PUBLIC_SOLANA_MAINNET_RPC_URL=https://your-production-mainnet-rpc.example
# Enable only after the SGT migration, Helius secret, and Edge Function are live.
EXPO_PUBLIC_SEEKER_VERIFICATION_ENABLED=false
EXPO_PUBLIC_SUPPORT_URL=https://seekase.app/support/
